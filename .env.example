# Copy to .env.local for local development. Replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Base Sepolia contracts and RPC
NEXT_PUBLIC_ENTRIES_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SOCIAL_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PROFILES_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MODERATION_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base mainnet contracts and RPC (leave addresses unset until deployed)
NEXT_PUBLIC_ENTRIES_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SOCIAL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PROFILES_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MODERATION_ADDRESS=0x0000000000000000000000000000000000000000
BASE_RPC_URL=https://mainnet.base.org

# Server-only media pinning credential. Never prefix with NEXT_PUBLIC_.
PINATA_JWT=your-pinata-jwt
